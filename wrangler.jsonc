{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo",
  "main": "src/index.js",
  "placement": { "mode": "smart" },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/mcp", "/mcp/*", "/authorize", "/oauth/*", "/.well-known/*", "/hooks/*"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "OWNER_EMAIL": "hinske.niclas@gmail.com",
    "TIMEZONE": "Europe/Berlin"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "todo-db", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV" }
  ],
  "observability": { "enabled": true }
}
